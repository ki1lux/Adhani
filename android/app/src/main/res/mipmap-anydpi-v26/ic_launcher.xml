<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8+). Without this the launcher falls back to
  the legacy bitmap and draws it inside a white plate, which looked nothing
  like the icon in DESIGN_IDENTITY.md.

  The foreground is the existing bitmap inset to sit inside the 66% safe zone
  the system masks to, so no part of the mark is clipped by a circle, squircle
  or rounded-square mask.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="18%" />
    </foreground>
    <monochrome>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="18%" />
    </monochrome>
</adaptive-icon>
